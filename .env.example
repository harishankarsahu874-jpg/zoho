# Copy to .env and fill in. Every variable used by the app is listed here.

# --- LLM (optional). Without a key, the assistant falls back to the
# in-repo rule-based parser; the manual booking form always works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Auth
JWT_SECRET=change-me-in-deployment
JWT_ALGORITHM=HS256

# --- Database
DATABASE_URL=sqlite:///./data/crunchweek.db

# --- Misc
TEAM_NAME=Spectra Solvers
CORS_ORIGINS=http://localhost:5173
